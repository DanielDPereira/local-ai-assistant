# Assistente de IA Local — Variáveis de Ambiente
#
# Copie este arquivo para .env e ajuste os valores.
# Nunca adicione .env ao Git.

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Workspace ---
# Diretório de trabalho do agente (padrão: diretório corrente)
ASSISTANT_WORKSPACE=.

# --- Banco de dados ---
# Caminho do banco SQLite (padrão: data/assistant.db)
ASSISTANT_DB_PATH=data/assistant.db

# --- Telemetria ---
# Intervalo de coleta de hardware em segundos (padrão: 2)
ASSISTANT_HARDWARE_SAMPLING_INTERVAL=2

# --- Custos ---
# Preço do kWh em moeda local (padrão: 0.80 BRL)
ASSISTANT_ELECTRICITY_PRICE_KWH=0.80

# Potência estimada do sistema em watts (padrão: 45)
ASSISTANT_SYSTEM_POWER_WATTS=45
